# copy to .env (git-ignored; start.cmd/start.sh do this for you). Real environment variables win over this file.

# AI setup - pick ONE (or none):
#   1. Recommended: run `ant auth login` once (Anthropic CLI, see the workspace README). No key is stored here.
#   2. Or paste an API key from https://platform.claude.com below.
#   3. Or leave everything empty: the app runs fully OFFLINE from the stored answers (no cost).
# Options 1 and 2 are billed to your Claude Console organization. If both are set, the key wins.
ANTHROPIC_API_KEY=
# AI_MODE=auto            # auto = Claude if a login or key exists, else mock | claude | mock (force)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PREP_ROOT=../python-interview-prep
# PREP_ALLOW_EDIT=1       # start.cmd/start.sh and docker-compose already enable this for local use
# RUN_TIMEOUT_S=60
# PORT=8000               # used by start scripts / docker compose

# Copy to .env (start.sh / start.cmd do it for you). Without a key the coach runs in offline mock mode.
ANTHROPIC_API_KEY=
# AI_MODE=auto            # auto | claude | mock
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_EFFORT=medium        # low | medium | high
# PORT=8100
# COACH_ALLOW_SAVE=1      # 0 disables "save generated question to the bank"

# --- Phase B: multi-user storage and sign-in (leave empty for single-user local SQLite) ---
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=          # server only, never ship to the browser
# COACH_REVIEWERS=you@example.com   # comma-separated emails or user ids allowed to review submissions

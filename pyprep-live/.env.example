# copy to .env (git-ignored; start.cmd/start.sh do this for you). Real environment variables win over this file.

# AI coach. Leave the key empty to run in MOCK mode (offline, answers built from the example's own source/log).
ANTHROPIC_API_KEY=
# AI_MODE=auto            # auto = Claude if a key is set, else mock | claude | mock (force)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PREP_ROOT=../python-interview-prep
# PREP_ALLOW_EDIT=1       # start.cmd/start.sh and docker-compose already enable this for local use
# RUN_TIMEOUT_S=60
# PORT=8000               # used by start scripts / docker compose
